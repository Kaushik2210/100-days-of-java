<!--
  Reference example only -- not built by this repo, which has no build tool yet.
  In a real Maven project this file would sit at the project root, with
  BuildToolsDemo.java living at src/main/java/BuildToolsDemo.java instead of
  alongside this file, per Maven's standard directory layout.
-->
<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>my-app</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
